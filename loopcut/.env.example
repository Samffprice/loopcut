# Copy to .env and fill in. .env is gitignored.
LOOPCUT_API_KEY=
LOOPCUT_BASE_URL=
LOOPCUT_MODEL=
# Optional
# LOOPCUT_AUTO_RUN=false
# LOOPCUT_CHECKPOINT_BUDGET_MB=2048
# LOOPCUT_RUN_TIMEOUT=60
# Unset or 0: unlimited. Optional positive cap for evals/power users (up to 10000).
# LOOPCUT_MAX_STEPS=0
# Selective independent review (off by default; uses additional model calls).
# Same provider/model/key as the executor unless overridden. See CONTROLLER.md.
# LOOPCUT_CONTROLLER=off
# LOOPCUT_CONTROLLER_MAX_CALLS=8
# LOOPCUT_CONTROLLER_MAX_SECONDS=30
# LOOPCUT_CONTROLLER_MAX_USD=0.10
# LOOPCUT_CONTROLLER_PAID_MIN_CREDITS=20
# LOOPCUT_CONTROLLER_MAX_CORRECTIONS=2
# LOOPCUT_CONTROLLER_MODEL=
# LOOPCUT_CONTROLLER_BASE_URL=
# LOOPCUT_CONTROLLER_API_KEY=
